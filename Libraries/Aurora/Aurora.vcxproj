    <!-- Slang shaders minified into a C++ header, and the default main entry points compiled with slangc. -->
    <CustomBuild Include="Source\Shaders\MainEntryPoints.slang">
      <Message>Packing the Aurora shaders (Slang)</Message>
      <Command>if not exist "$(IntDir)Generated\CompiledShaders" mkdir "$(IntDir)Generated\CompiledShaders"
set DXC_LIBRARY_DIR=$(AuroraExternals)DXC\bin
set ENABLE_NRD=ON
set NRD_SHADERS_INCLUDE_DIR=$(AuroraExternals)NRD\Shaders
set NRD_SHADERS_SOURCE_DIR=$(AuroraExternals)NRD\Shaders\Source
$(AuroraPython) "$(AuroraRoot)Scripts\minifyShadersFolder.py" "$(MSBuildThisFileDirectory)Source\Shaders" "$(IntDir)Generated\CompiledShaders\CommonShaders.h" "$(AuroraExternals)Slang\bin\slangc.exe"</Command>
      <AdditionalInputs>$(MSBuildThisFileDirectory)Source\Shaders\BSDF.slang;$(MSBuildThisFileDirectory)Source\Shaders\BSDFCommon.slang;$(MSBuildThisFileDirectory)Source\Shaders\Colors.slang;$(MSBuildThisFileDirectory)Source\Shaders\DefaultMaterialUniformAccessors.slang;$(MSBuildThisFileDirectory)Source\Shaders\DefaultMaterialUniformBuffer.slang;$(MSBuildThisFileDirectory)Source\Shaders\DefaultMaterial.slang;$(MSBuildThisFileDirectory)Source\Shaders\Environment.slang;$(MSBuildThisFileDirectory)Source\Shaders\Frame.slang;$(MSBuildThisFileDirectory)Source\Shaders\Geometry.slang;$(MSBuildThisFileDirectory)Source\Shaders\Globals.slang;$(MSBuildThisFileDirectory)Source\Shaders\GroundPlane.slang;$(MSBuildThisFileDirectory)Source\Shaders\InstancePipelineState.slang;$(MSBuildThisFileDirectory)Source\Shaders\GlobalPipelineState.slang;$(MSBuildThisFileDirectory)Source\Shaders\HitShaderEntryPoints.slang;$(MSBuildThisFileDirectory)Source\Shaders\Material.slang;$(MSBuildThisFileDirectory)Source\Shaders\GlobalBufferAccessors.slang;$(MSBuildThisFileDirectory)Source\Shaders\MaterialXCommon.slang;$(MSBuildThisFileDirectory)Source\Shaders\Options.slang;$(MSBuildThisFileDirectory)Source\Shaders\PathTracingCommon.slang;$(MSBuildThisFileDirectory)Source\Shaders\ShadeFunctions.slang;$(MSBuildThisFileDirectory)Source\Shaders\Random.slang;$(MSBuildThisFileDirectory)Source\Shaders\RayTrace.slang;$(MSBuildThisFileDirectory)Source\Shaders\ReferenceBSDF.slang;$(MSBuildThisFileDirectory)Source\Shaders\StandardSurfaceBSDF.slang;$(MSBuildThisFileDirectory)Source\Shaders\Sampling.slang;$(MSBuildThisFileDirectory)Source\Shaders\NRD.slang;$(AuroraRoot)Scripts\minifyShadersFolder.py</AdditionalInputs>
      <Outputs>$(IntDir)Generated\CompiledShaders\CommonShaders.h</Outputs>
    </CustomBuild>
    <!-- NRD.hlsli resolved by the Slang transpiler at run time: embedded verbatim. -->
