$(AuroraPython) "$(AuroraRoot)Scripts\embedShaderFiles.py" "$(IntDir)Generated\CompiledShaders\NRDShaders.h" NRDShaders "$(AuroraExternals)NRD\Shaders\NRD.hlsli" "$(AuroraExternals)NRD\Shaders\NRDConfig.hlsli"</Command>
      <AdditionalInputs>$(AuroraExternals)NRD\Shaders\NRDConfig.hlsli;$(AuroraRoot)Scripts\embedShaderFiles.py</AdditionalInputs>
      <Outputs>$(IntDir)Generated\CompiledShaders\NRDShaders.h</Outputs>
    </CustomBuild>
